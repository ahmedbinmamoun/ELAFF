# ─── Application ──────────────────────────────────────────────
APP_NAME="إيلاف"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Khartoum
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_MAINTENANCE_DRIVER=file

# Host port nginx is published on (docker compose).
APP_PORT=8080

# Container user mapping (dev): set to the output of `id -u` / `id -g`.
UID=1000
GID=1000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Database (MySQL 8 in Docker) ─────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=elaf
DB_USERNAME=elaf
DB_PASSWORD=secret
# Only used by the mysql container on first start.
DB_ROOT_PASSWORD=root-secret

# ─── Redis: cache, queue, sessions ────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=elaf_
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Mail (Mailpit in dev) ────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@elaf.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Contributors (FR-CON-03, 08, 13)
ELAF_CONTRIBUTORS_REQUIRE_ACCOUNT_APPROVAL=true
ELAF_CONTRIBUTORS_EDITOR_CAN_PUBLISH=false
ELAF_CONTRIBUTORS_GUEST_BYLINE_LABEL=true

# Cloudflare Turnstile (contributor registration). Leave empty in local
# development to skip the check; production refuses registrations without it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site identity (header/footer) until the Settings module (Phase 5)
ELAF_LOGO_SUFFIX="السودان"
ELAF_MOTTO="كلمة تبني وطنا"
ELAF_DESCRIPTION="صحيفة للاقتصاد السياسي السوداني ومحيطه"
ELAF_MASTHEAD_EDITOR_IN_CHIEF=
ELAF_MASTHEAD_EDITORIAL_ADVISOR=
ELAF_MASTHEAD_PUBLISHER=
ELAF_CONTACT_EMAIL=
ELAF_FACEBOOK_URL=
ELAF_WHATSAPP_CHANNEL_URL=
ELAF_YOUTUBE_URL=
ELAF_X_URL=
